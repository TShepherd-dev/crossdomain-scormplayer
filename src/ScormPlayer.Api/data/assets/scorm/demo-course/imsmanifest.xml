<?xml version="1.0" standalone="no"?>
<manifest identifier="com.demo.scorm-course"
    version="1"
    xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
    xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2
        imscp_rootv1p1p2.xsd
        http://www.adlnet.org/xsd/adlcp_rootv1p2
        adlcp_rootv1p2.xsd">
    <metadata>
        <schema>ADL SCORM</schema>
        <schemaversion>1.2</schemaversion>
    </metadata>
    <organizations default="demo_org">
        <organization identifier="demo_org">
            <title>Demo SCORM Course</title>
            <item identifier="demo_item" identifierref="demo_resource">
                <title>Demo SCORM Course</title>
                <adlcp:masteryscore>80</adlcp:masteryscore>
            </item>
        </organization>
    </organizations>
    <resources>
        <resource identifier="demo_resource"
            type="webcontent"
            adlcp:scormtype="sco"
            href="index.html">
            <file href="index.html"/>
        </resource>
    </resources>
</manifest>
